{
  "name": "plex-rating-quest",
  "version": "2.0.6",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "overrides": {
    "postcss": "8.5.25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "start": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"src/**/*.{ts,tsx}\" \"store/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "mobx": "^7.0.0",
    "mobx-react-lite": "^5.0.0",
    "motion-dom": "12.43.0",
    "motion-utils": "12.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
