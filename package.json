{
  "name": "plex-rating-quest",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "postcss": "8.5.25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "start": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"src/**/*.{ts,tsx}\" \"store/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.468.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.0",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "9.39.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "17.9.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "8.0.13",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
