{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "server-dist",
    "rootDir": "server",
    "types": ["node"],
    "incremental": false,
    "isolatedModules": false,
    "resolveJsonModule": false
  },
  "include": ["server/**/*.ts"]
}
