# Optional host port override.
PLEX_RATING_PORT=8080
PLEX_RATING_PUBLIC_ORIGIN=https://plexquest.example.com

# Optional comma-separated exact hosts allowed to resolve to private/LAN addresses.
PLEX_ALLOWED_PRIVATE_HOSTS=

# Optional path to the persistent Compose secret file.
PLEX_RATING_SESSION_SECRET_FILE=./secrets/session_secret
